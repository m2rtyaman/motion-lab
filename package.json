{
  "name": "motion-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "dev": "vite",
    "studio:preview": "remotion preview src/remotion/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:css": "npx @tailwindcss/cli -i src/index.css -o src/output.css",
    "registry": "node scripts/gen-registry.mjs",
    "new": "node scripts/new-project.mjs",
    "doctor": "node scripts/studio-doctor.mjs",
    "gate": "node scripts/pre-render-gate.mjs",
    "audit:spec": "node scripts/validate-spec.mjs",
    "audit:storyboard": "node scripts/audit-storyboard.mjs",
    "audit:ast": "node scripts/ast-lint.mjs",
    "audit:motion": "node scripts/motion-audit.mjs",
    "audit:slop": "node scripts/slop-linter.mjs",
    "audit:craft": "node scripts/craft-audit.mjs",
    "audit:visual": "node scripts/visual-qa.mjs",
    "audit:critic": "node scripts/critic-audit.mjs",
    "audit:glyph": "node scripts/glyph-audit.mjs",
    "audit:templates": "node scripts/test-templates.mjs",
    "gen:manifest": "node scripts/gen-template-manifest.mjs",
    "audit:doctor": "node scripts/studio-doctor.mjs",
    "studio:doctor": "node scripts/studio-doctor.mjs",
    "inspect": "node scripts/inspect-frame.mjs",
    "studio:brief": "node scripts/studio-brief.mjs",
    "music:map": "node scripts/music-mapper.mjs",
    "export:skill": "node scripts/export-skill.mjs",
    "studio": "node scripts/studio.mjs",
    "studio:init": "node scripts/studio.mjs init",
    "studio:next": "node scripts/studio.mjs next",
    "studio:check": "node scripts/studio.mjs check",
    "studio:run": "node scripts/studio.mjs run",
    "check": "node scripts/check-runner.mjs",
    "render": "node scripts/render.mjs",
    "render:commercial": "pnpm build:css && pnpm check && remotion render src/remotion/index.ts octosift-commercial out/octosift-commercial/octosift-commercial.mp4 --gl=angle",
    "render:showreel": "pnpm build:css && pnpm check && remotion render src/remotion/index.ts kinetic-loud-showreel out/kinetic-loud-showreel/kinetic-loud-showreel.mp4 --gl=angle",
    "render:arena": "pnpm build:css && pnpm check && remotion render src/remotion/index.ts dwarf-arena out/dwarf-arena/dwarf-arena.mp4 --gl=angle",
    "render:contact-sheet": "pnpm build:css && node scripts/contact-sheet.mjs",
    "render:still": "pnpm build:css && remotion still src/remotion/index.ts octosift-commercial out/octosift-commercial/preview.png --frame=60"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.10",
    "@react-three/drei": "^10.7.9",
    "@remotion/cli": "^4.0.539",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/fiber": "^9.8.2",
    "@remotion/player": "^4.0.539",
    "@remotion/three": "^4.0.539",
    "@types/three": "^0.187.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.65.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.539",
    "roughjs": "^4.6.6",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "yaml": "^2.9.1"
  }
}
