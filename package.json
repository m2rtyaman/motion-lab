{
  "name": "motion-lab",
  "private": true,
  "version": "0.9.1",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "dev": "vite",
    "studio:preview": "remotion preview src/remotion/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:css": "npx @tailwindcss/cli -i src/index.css -o src/output.css",
    "registry": "node scripts/gen-registry.mjs",
    "new": "node scripts/new-project.mjs",
    "doctor": "node scripts/studio-doctor.mjs",
    "gate": "node scripts/pre-render-gate.mjs",
    "ref:measure": "node scripts/measure-reference.mjs",
    "audit:spec": "node scripts/validate-spec.mjs",
    "audit:storyboard": "node scripts/audit-storyboard.mjs",
    "audit:storyboard2": "node scripts/storyboard-audit.mjs",
    "audit:ast": "node scripts/ast-lint.mjs",
    "audit:timeline": "npx tsx scripts/timeline-audit.mjs",
    "audit:motion": "node scripts/motion-audit.mjs",
    "audit:slop": "node scripts/slop-linter.mjs",
    "audit:craft": "node scripts/craft-audit.mjs",
    "audit:visual": "node scripts/visual-qa.mjs",
    "audit:critic": "node scripts/critic-audit.mjs",
    "audit:glyph": "node scripts/glyph-audit.mjs",
    "audit:templates": "node scripts/test-templates.mjs",
    "gen:manifest": "node scripts/gen-template-manifest.mjs",
    "docs:math": "npx tsx scripts/gen-motion-math.mjs",
    "docs:design": "npx tsx scripts/gen-design-system.mjs",
    "audit:doctor": "node scripts/studio-doctor.mjs",
    "studio:doctor": "node scripts/studio-doctor.mjs",
    "inspect": "node scripts/inspect-frame.mjs",
    "studio:brief": "node scripts/studio-brief.mjs",
    "music:map": "node scripts/music-mapper.mjs",
    "export:skill": "node scripts/export-skill.mjs",
    "studio": "node scripts/studio.mjs",
    "studio:init": "node scripts/studio.mjs init",
    "studio:next": "node scripts/studio.mjs next",
    "studio:check": "node scripts/studio.mjs check",
    "studio:run": "node scripts/studio.mjs run",
    "check": "node scripts/check-runner.mjs",
    "render": "node scripts/render.mjs",
    "render:broll": "pnpm build:css && pnpm check && remotion render src/remotion/index.ts single-container-broll out/single-container-broll/single-container-broll.mp4 --gl=angle",
    "render:showreel": "pnpm build:css && pnpm check && remotion render src/remotion/index.ts kinetic-loud-showreel out/kinetic-loud-showreel/kinetic-loud-showreel.mp4 --gl=angle",
    "render:arena": "pnpm build:css && pnpm check && remotion render src/remotion/index.ts dwarf-arena out/dwarf-arena/dwarf-arena.mp4 --gl=angle",
    "render:contact-sheet": "pnpm build:css && node scripts/contact-sheet.mjs",
    "render:poses": "pnpm build:css && node scripts/render-poses.mjs",
    "render:still": "pnpm build:css && remotion still src/remotion/index.ts single-container-broll out/single-container-broll/preview.png --frame=60",
    "harvest": "uv run scripts/harvest/cli.py",
    "harvest:voice": "uv run scripts/harvest/voice.py",
    "harvest:broll": "uv run scripts/harvest/broll.py",
    "test:presets": "npx tsx scripts/test-presets.mjs",
    "test:physics": "npx tsx scripts/test-physics.mjs",
    "test:timeline": "node scripts/test-timeline-audit.mjs",
    "test:evals": "node scripts/test-evals.mjs && node scripts/test-evals-cheats.mjs",
    "probe": "node scripts/browser-probe.mjs",
    "test:probe": "node scripts/test-browser-probe.mjs",
    "eval:visual": "node scripts/eval-visual.mjs",
    "eval:score": "node scripts/eval-score.mjs",
    "eval:all": "node scripts/eval-score.mjs --all",
    "eval:lock": "node scripts/eval-lock.mjs",
    "test:harvest": "uv run scripts/harvest/test_harvest.py"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@remotion/cli": "^4.0.541",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@remotion/player": "^4.0.541",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.541",
    "roughjs": "^4.6.6",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1"
  }
}
