{
  "$schema": "../../../specs/motion-spec.schema.json",
  "version": 1,
  "title": "Ship It Kinetic Poster",
  "mode": "kinetic-poster",
  "aspect": "9:16",
  "fps": 60,
  "durationInSeconds": 3,
  "safeZone": { "top": 250, "bottom": 300 },
  "beats": [
    { "id": "reveal", "startFrame": 0, "endFrame": 59, "intent": "Başlık derinlikten flu ve büyük gelir, keskinleşir", "action": "reveal" },
    { "id": "stamp", "startFrame": 60, "endFrame": 119, "intent": "Damga aşırı-atışla oturur, darbe sarsıntısı", "action": "stamp" },
    { "id": "hold", "startFrame": 120, "endFrame": 180, "intent": "Yavaş itme ile tutuş", "action": "hold" }
  ],
  "camera": [
    { "at": 0.05, "duration": 1.2, "ease": "power2.out", "intent": "Başlık girişinde geri çekilme" },
    { "at": 1.5, "duration": 1.4, "ease": "power2.inOut", "intent": "Kapanışa yavaş itme" }
  ],
  "shakes": [{ "at": 0.9, "steps": 5, "stepDuration": 0.06, "amplitudePx": 12 }],
  "sfx": []
}
