{
  "$schema": "../../../specs/motion-spec.schema.json",
  "version": 1,
  "title": "Institutional Liquidity Terminal Teaser",
  "mode": "editorial-ui",
  "aspect": "9:16",
  "fps": 60,
  "durationInSeconds": 4,
  "safeZone": { "top": 250, "bottom": 300 },
  "narrativeArc": "Metric-Storytelling",
  "theme": {
    "surfaceMode": "dark"
  },
  "componentStack": [
    "SpatialCamera",
    "VirtualCanvas",
    "MetricCardRow",
    "ChartCanvas",
    "KineticHeadline"
