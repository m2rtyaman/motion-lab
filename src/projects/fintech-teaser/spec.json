      "action": "telemetry-entry"
    },
    {
      "id": "volume-surge",
      "startFrame": 60,
      "endFrame": 154,
      "intent": "3D izometrik eğimle derinlik ve hacim grafiği patlaması",
      "action": "chart-surge"
    },
    {
      "id": "settle-resolve",
      "startFrame": 155,
      "endFrame": 240,
      "intent": "Kameranın yerleşmesi ve sub-millisecond uzlaşma onayı",
      "action": "macro-resolve"
    }
  ],
  "camera": [
    {
      "at": 0.05,
      "duration": 0.65,
      "ease": "expo.out",
      "intent": "3D izometrik telemetri açısına giriş"
    },
    {
      "at": 0.95,
      "duration": 0.65,
      "ease": "power2.out",
      "intent": "Hacim spline grafiğine odaklanma"
    },
    {
      "at": 2.3,
      "duration": 0.65,
      "ease": "expo.out",
      "intent": "Geriye yumuşak makro açılma"
    },
    {
      "at": 3.2,
      "duration": 0.65,
      "ease": "expo.out",
      "intent": "Kapanışta düzleme yerleşme"
    }
  ],
  "shakes": [],
  "sfx": []
