{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Motion Spec v1",
  "description": "Kod yazılmadan önce onaylanması zorunlu hareket sözleşmesi. Kural doğrulaması scripts/validate-spec.mjs içindedir; bu şema editör desteği ve dokümantasyon içindir.",
  "type": "object",
  "required": ["version", "title", "mode", "aspect", "fps", "durationInSeconds", "safeZone", "beats", "camera"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["cinematic-world", "editorial-ui", "kinetic-poster"] },
    "aspect": { "enum": ["9:16", "16:9"] },
    "fps": { "const": 60 },
    "durationInSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
    "safeZone": {
      "type": "object",
      "required": ["top", "bottom"],
      "properties": { "top": { "type": "number", "minimum": 250 }, "bottom": { "type": "number", "minimum": 300 } }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "startFrame", "endFrame", "intent"],
        "properties": {
          "id": { "type": "string" },
          "startFrame": { "type": "integer", "minimum": 0 },
          "endFrame": { "type": "integer", "minimum": 0 },
          "intent": { "type": "string", "minLength": 3 },
          "action": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "camera": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["at", "duration", "ease", "intent"],
        "properties": {
          "at": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "minimum": 0.05, "maximum": 2.5 },
          "ease": { "type": "string" },
          "intent": { "type": "string" }
        }
      }
    },
    "shakes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "steps", "stepDuration", "amplitudePx"],
        "properties": {
          "at": { "type": "number", "minimum": 0 },
          "steps": { "type": "integer", "minimum": 2, "maximum": 8 },
          "stepDuration": { "type": "number", "minimum": 0.04, "maximum": 0.12 },
          "amplitudePx": { "type": "number", "minimum": 2, "maximum": 30 }
        }
      }
    },
    "sfx": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame", "sfx"],
        "properties": { "frame": { "type": "integer", "minimum": 0 }, "sfx": { "type": "string" } }
      }
    }
  }
}
