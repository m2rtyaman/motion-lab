{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Motion Spec v1",
  "description": "Kod yazılmadan önce onaylanması zorunlu hareket sözleşmesi. Kural doğrulaması scripts/validate-spec.mjs içindedir; bu şema editör desteği ve dokümantasyon içindir.",
  "type": "object",
  "required": ["version", "title", "mode", "aspect", "fps", "durationInSeconds", "safeZone", "beats"],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": { "aspect": { "const": "9:16" } }
      },
      "then": {
        "properties": {
          "safeZone": {
            "type": "object",
            "properties": {
              "top": { "type": "number", "minimum": 250 },
              "bottom": { "type": "number", "minimum": 300 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "aspect": { "const": "16:9" } }
      },
      "then": {
        "properties": {
          "safeZone": {
            "type": "object",
            "properties": {
              "top": { "type": "number", "minimum": 30 },
              "bottom": { "type": "number", "minimum": 30 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "aspect": { "const": "1:1" } }
      },
      "then": {
        "properties": {
          "safeZone": {
            "type": "object",
            "properties": {
              "top": { "type": "number", "minimum": 30 },
              "bottom": { "type": "number", "minimum": 30 }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "harness": { "const": 2, "description": "Opt-in to Harness v2: Scene.tsx exports buildTimeline and is verified behaviorally by scripts/timeline-audit.mjs (keyword audits are skipped)." },
    "evalTask": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Optional: id of an exercise in evals/tasks/<id>; makes pnpm eval:all score this project." },
    "audit": {
      "type": "object",
      "description": "Per-project timeline-audit settings. allow suppresses intentional findings (printed as [allowed]).",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "reason"],
            "properties": {
              "code": { "type": "string", "pattern": "^T[0-9]{3}$" },
              "reason": { "type": "string", "minLength": 15, "description": "Why this finding is intentional (>= 15 chars)." }
            }
          }
        }
      }
    },
    "title": { "type": "string", "minLength": 1 },
    "mode": {
      "enum": [
        "cinematic-world",
        "editorial-ui",
        "kinetic-poster",
        "creative-motion-reel",
        "hybrid-orchestrated"
      ]
    },
    "aspect": { "enum": ["9:16", "16:9", "1:1"] },
    "fps": { "const": 60 },
    "durationInSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
    "safeZone": {
      "type": "object",
      "required": ["top", "bottom"],
      "properties": {
        "top": { "type": "number", "minimum": 0 },
        "bottom": { "type": "number", "minimum": 0 }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "surfaceMode": {
          "type": "string",
          "enum": ["light", "dark", "vibrant-brand", "editorial-warm", "kinetic-acid", "technical-drafting"]
        }
      }
    },
    "harvest": {
      "type": "object",
      "properties": {
        "voice": { "type": "string" },
        "script": { "type": "string" },
        "broll": { "type": "array" }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "archetype", "startFrame", "endFrame"],
        "properties": {
          "id": { "type": "string" },
          "archetype": { "type": "string" },
          "startFrame": { "type": "integer", "minimum": 0 },
          "endFrame": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string" },
              "atFrame": { "type": "integer", "minimum": 0 },
              "durationFrames": { "type": "integer" },
              "bridge": { "type": "string" }
            }
          }
        ]
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "startFrame", "endFrame", "intent"],
        "properties": {
          "id": { "type": "string" },
          "startFrame": { "type": "integer", "minimum": 0 },
          "endFrame": { "type": "integer", "minimum": 0 },
          "intent": { "type": "string", "minLength": 3 },
          "action": { "type": "string" },
          "text": { "type": "string" },
          "samples": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "Extra frames the contact sheet must show for this beat (e.g. the contact frame of a bounce)." },
          "board": {
            "type": "object",
            "description": "Storyboard card (harness v2, checked by scripts/storyboard-audit.mjs, rules SB001-SB007). See docs/STORYBOARD.md.",
            "required": ["focal", "zone", "start", "end", "why"],
            "properties": {
              "focal": { "type": "string", "minLength": 2, "description": "CSS selector of the one element the viewer must look at; must match a static className/id in Scene.tsx (SB002)." },
              "zone": { "type": "string", "enum": ["top-left", "top-center", "top-right", "middle-left", "middle-center", "middle-right", "bottom-left", "bottom-center", "bottom-right", "center", "top", "bottom", "left", "right"], "description": "3x3 grid cell where the focal sits." },
              "start": { "type": "string", "minLength": 3, "description": "Key pose at beat start, one sentence." },
              "end": { "type": "string", "minLength": 3, "description": "Key pose at beat end, one sentence." },
              "text": { "type": "array", "items": { "type": "string" }, "description": "On-screen strings introduced in this beat; must be rendered in Scene.tsx (SB005) and readable in the beat time (SB003)." },
              "transitionIn": { "type": "string", "description": "Preset (e.g. transition:maskWipe, camera:pushIn) or the word cut." },
              "why": { "type": "string", "minLength": 3, "description": "Motivation, one clause. The final beat must mention the hold (SB006)." }
            }
          }
        }
      }
    },
    "camera": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "duration", "ease", "intent"],
        "properties": {
          "at": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "minimum": 0.05, "maximum": 2.5 },
          "ease": { "type": "string" },
          "intent": { "type": "string" }
        }
      }
    },
    "shakes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "steps", "stepDuration", "amplitudePx"],
        "properties": {
          "at": { "type": "number", "minimum": 0 },
          "steps": { "type": "integer", "minimum": 2, "maximum": 8 },
          "stepDuration": { "type": "number", "minimum": 0.04, "maximum": 0.12 },
          "amplitudePx": { "type": "number", "minimum": 2, "maximum": 30 }
        }
      }
    },
    "sfx": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame", "sfx"],
        "properties": { "frame": { "type": "integer", "minimum": 0 }, "sfx": { "type": "string" } }
      }
    },
    "singleContainer": { "type": "boolean" },
    "continuousShot": { "type": "boolean" },
    "legacy": { "type": "boolean" },
    "componentStack": { "type": "array", "items": { "type": "string" } },
    "detectedWidgets": { "type": "array", "items": { "type": "string" } }
  }
}
